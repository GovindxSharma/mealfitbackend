# ==============================================================================
# MealFit Backend - Production & Render Environment Configuration
# ==============================================================================

# Server Port (Render sets this dynamically via $PORT, defaults to 5050 if unset)
PORT=5050

# Environment Mode ('production' on Render / 'development' locally)
NODE_ENV=production

# Database Connection (MongoDB Atlas Cloud M0 Free Tier or self-hosted MongoDB)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
# Example: mongodb+srv://mealfit_admin:yourpassword@cluster0.abcde.mongodb.net/mealfit?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mealfit?retryWrites=true&w=majority

# JWT Authentication Secret Key (Used for signing & verifying user authentication tokens)
# Minimum 32 characters recommended for production security.
# (Note: On Render, render.yaml generates this automatically if using Blueprint)
JWT_SECRET=mealfit_super_secret_jwt_production_key_2026_change_me

# Allowed CORS Origins (Comma-separated URLs or '*' to allow all clients/mobile apps)
# Example: * or https://mealfit.onrender.com,http://localhost:5173,http://localhost:3000
CORS_ORIGIN=*
